{
  "manifest_version": 3,
  "name": "AetherBolt Extension Smoke Test",
  "version": "0.1.0",
  "description": "Adds a visible badge to example.com only; no network calls.",
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}