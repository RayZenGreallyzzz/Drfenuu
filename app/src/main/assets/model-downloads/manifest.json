{
  "manifest_version": 3,
  "name": "3D Downloader",
  "description": "Find 3D files loaded by the selected page.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "model-downloads@aetherbolt.local",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "permissions": ["activeTab", "downloads", "storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_popup": "popup.html", "default_title": "3D Downloader"}
}
